# ─────────────────────────────────────────────────────────────
# IT Hub ERP environment variables
# Copy to `.env` for local development:  cp .env.example .env
# Never commit `.env`. Validated at startup by src/lib/env/schema.ts.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://erp:erp@localhost:5432/it_hub_erp?schema=public"

# Public base URL of the app (used in emails and links).
APP_URL="http://localhost:3000"

# Log verbosity: debug | info | warn | error (default: debug in development, info in production).
LOG_LEVEL=""

# ── Accounts ─────────────────────────────────────────────────
# "true" lets anyone create a new company account at /register. Default: invitation only.
AUTH_ALLOW_REGISTRATION="false"

# ── Email (password reset, verification, invitations) ────────
# smtp = real email (default and required in production); console = print emails with their links
# to the server log (local development / CI). Local `npm run start` needs "console" or real SMTP.
EMAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT="587"
# "true" for implicit TLS (port 465); otherwise STARTTLS is used when offered.
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# ── File storage, S3-compatible (optional until uploads ship) ─
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ── Seed only (`npm run db:seed`) — not read by the app ──────
# The first company and its Owner account. Re-running the seed never changes an existing password.
SEED_COMPANY_NAME="IT Hub"
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL=""
# At least 12 characters.
SEED_ADMIN_PASSWORD=""

# ── Tests only ────────────────────────────────────────────────
# Separate PostgreSQL database for integration tests. It is wiped between tests,
# so its name MUST contain "test" (the test runner refuses anything else).
TEST_DATABASE_URL="postgresql://erp:erp@localhost:5432/it_hub_erp_test?schema=public"
