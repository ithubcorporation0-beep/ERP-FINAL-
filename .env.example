# ─────────────────────────────────────────────────────────────
# IT Hub ERP environment variables
# Copy to `.env` for local development:  cp .env.example .env
# Never commit `.env`. Validated at startup by src/lib/env/schema.ts.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://erp:erp@localhost:5432/it_hub_erp?schema=public"

# Public base URL of the app (used in emails and links).
APP_URL="http://localhost:3000"

# Log verbosity: debug | info | warn | error (default: debug in development, info in production).
LOG_LEVEL=""

# ── Accounts ─────────────────────────────────────────────────
# "true" lets anyone create a new company account at /register. Default: invitation only.
AUTH_ALLOW_REGISTRATION="false"

# ── Email (password reset, verification, invitations) ────────
# smtp = real email (default and required in production); console = print emails with their links
# to the server log (local development / CI). Local `npm run start` needs "console" or real SMTP.
EMAIL_TRANSPORT="console"
SMTP_HOST=""
SMTP_PORT="587"
# "true" for implicit TLS (port 465); otherwise STARTTLS is used when offered.
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# ── File storage (company logos; later attachments) ───────────
# local = a folder on this server (development; single server with a persistent disk)
# s3    = any S3-compatible service (AWS S3, Cloudflare R2, MinIO). Default and required in production
#         unless you explicitly choose local. Keep the bucket private — files are served through the app.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# ── Data protection ──────────────────────────────────────────
# Encrypts employee bank account numbers and IBANs at rest. 32 random bytes, base64: `openssl rand -base64 32`.
# Required in production. Keep it secret and backed up — without it stored bank details can't be read.
DATA_ENCRYPTION_KEY=

# ── Notifications scheduler ──────────────────────────────────
# Lets a cron service call POST /api/cron/notifications with "Authorization: Bearer <secret>" every few minutes
# (reminders + email delivery). At least 32 characters: `openssl rand -hex 32`. Leave empty to disable the endpoint
# and run `npm run notifications:run` from the server's own cron instead.
CRON_SECRET=

# ── Seed only (`npm run db:seed`) — not read by the app ──────
# The first company and its Owner account. Re-running the seed never changes an existing password.
SEED_COMPANY_NAME="IT Hub"
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL=""
# At least 12 characters.
SEED_ADMIN_PASSWORD=""

# ── Tests only ────────────────────────────────────────────────
# Separate PostgreSQL database for integration tests. It is wiped between tests,
# so its name MUST contain "test" (the test runner refuses anything else).
TEST_DATABASE_URL="postgresql://erp:erp@localhost:5432/it_hub_erp_test?schema=public"
