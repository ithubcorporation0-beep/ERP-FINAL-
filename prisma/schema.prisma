// IT Hub ERP — core platform schema (phase 02).
//
// Conventions (see docs/database.md):
// - Tables and columns are snake_case in PostgreSQL (@@map / @map); models and fields are PascalCase / camelCase in TypeScript.
// - IDs are UUID v7 (time-ordered) stored as native `uuid`.
// - Every tenant-owned table has `company_id`. Child tables carry it too, with a composite foreign key
//   to their parent so a row can never point at another company's data.
// - Editable records have created_at / updated_at / created_by / updated_by. Timestamps are `timestamptz`.
// - ERP module tables (invoices, employees, …) are added by their own phases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ─── Companies (tenants) ─────────────────────────────────────

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("company_status")
}

model Company {
  id                   String        @id @default(uuid(7)) @db.Uuid
  name                 String
  legalName            String?       @map("legal_name")
  /// URL-safe unique identifier, e.g. "it-hub".
  slug                 String        @unique
  status               CompanyStatus @default(ACTIVE)
  taxId                String?       @map("tax_id")
  email                String?
  phone                String?
  address              String?
  /// ISO 3166-1 alpha-2, e.g. "US".
  country              String?       @db.Char(2)
  /// ISO 4217, e.g. "USD". All monetary values of the company are in this currency unless stated.
  baseCurrency         String        @default("USD") @map("base_currency") @db.Char(3)
  /// IANA time zone, e.g. "Asia/Dubai".
  timezone             String        @default("UTC")
  /// BCP 47 locale for number and date formatting, e.g. "en-US".
  locale               String        @default("en-US")
  /// 1 = January.
  fiscalYearStartMonth Int           @default(1) @map("fiscal_year_start_month") @db.SmallInt
  /// Storage key of the logo image (see src/lib/storage). Null = no logo.
  logoKey              String?       @map("logo_key")
  logoContentType      String?       @map("logo_content_type")
  logoUpdatedAt        DateTime?     @map("logo_updated_at") @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById          String?       @map("created_by") @db.Uuid
  updatedById          String?       @map("updated_by") @db.Uuid
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(3)

  createdBy              User?                   @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?                   @relation("CompanyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  memberships            Membership[]
  roles                  Role[]
  rolePermissions        RolePermission[]
  settings               Setting[]
  auditLogs              AuditLog[]
  customers              Customer[]
  customerDocuments      CustomerDocument[]
  customerCommunications CustomerCommunication[]
  leads                  Lead[]
  numberSequences        NumberSequence[]
  quotations             Quotation[]
  quotationItems         QuotationItem[]
  invoices               Invoice[]
  invoiceItems           InvoiceItem[]
  payments               Payment[]
  shareLinks             ShareLink[]
  accounts               Account[]
  journalEntries         JournalEntry[]
  journalLines           JournalLine[]
  expenses               Expense[]
  departments            Department[]
  employees              Employee[]
  employeeCompensations  EmployeeCompensation[]
  employeeDocuments      EmployeeDocument[]
  attendanceRecords      AttendanceRecord[]
  leaveRequests          LeaveRequest[]
  salaryComponents       SalaryComponent[]
  salaryAdvances         SalaryAdvance[]
  payrollRuns            PayrollRun[]
  payrollItems           PayrollItem[]
  projects               Project[]
  tasks                  Task[]
  taskAttachments        TaskAttachment[]
  productCategories      ProductCategory[]
  warehouses             Warehouse[]
  products               Product[]
  stockMovements         StockMovement[]
  suppliers              Supplier[]
  purchaseRequests       PurchaseRequest[]
  purchaseRequestItems   PurchaseRequestItem[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderItems     PurchaseOrderItem[]
  goodsReceipts          GoodsReceipt[]
  goodsReceiptItems      GoodsReceiptItem[]
  supplierInvoices       SupplierInvoice[]
  supplierPayments       SupplierPayment[]
  notifications          Notification[]
  authTokens             AuthToken[]
  sessions               Session[]

  @@map("companies")
}

// ─── Users & sessions (global; linked to companies through memberships) ─

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED

  @@map("user_status")
}

model User {
  id                  String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-case.
  email               String     @unique
  name                String
  passwordHash        String     @map("password_hash")
  status              UserStatus @default(ACTIVE)
  phone               String?
  jobTitle            String?    @map("job_title")
  /// Null until the user proves they own the address (verification or invitation link).
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  /// Consecutive failed sign-ins; reset on success. Too many → `lockedUntil`.
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById         String?    @map("created_by") @db.Uuid
  updatedById         String?    @map("updated_by") @db.Uuid

  createdBy User? @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  sessions      Session[]
  authTokens    AuthToken[]    @relation("AuthTokenUser")
  memberships   Membership[]   @relation("MembershipUser")
  notifications Notification[]
  auditLogs     AuditLog[]

  // Back-relations for created_by / updated_by columns (required by Prisma, not used in code).
  usersCreated                  User[]                  @relation("UserCreatedBy")
  usersUpdated                  User[]                  @relation("UserUpdatedBy")
  companiesCreated              Company[]               @relation("CompanyCreatedBy")
  companiesUpdated              Company[]               @relation("CompanyUpdatedBy")
  rolesCreated                  Role[]                  @relation("RoleCreatedBy")
  rolesUpdated                  Role[]                  @relation("RoleUpdatedBy")
  rolePermissionsCreated        RolePermission[]        @relation("RolePermissionCreatedBy")
  membershipsCreated            Membership[]            @relation("MembershipCreatedBy")
  membershipsUpdated            Membership[]            @relation("MembershipUpdatedBy")
  settingsCreated               Setting[]               @relation("SettingCreatedBy")
  settingsUpdated               Setting[]               @relation("SettingUpdatedBy")
  customersCreated              Customer[]              @relation("CustomerCreatedBy")
  customersUpdated              Customer[]              @relation("CustomerUpdatedBy")
  customerDocumentsCreated      CustomerDocument[]      @relation("CustomerDocumentCreatedBy")
  customerCommunicationsCreated CustomerCommunication[] @relation("CustomerCommunicationCreatedBy")
  leadsAssigned                 Lead[]                  @relation("LeadAssignedTo")
  leadsCreated                  Lead[]                  @relation("LeadCreatedBy")
  leadsUpdated                  Lead[]                  @relation("LeadUpdatedBy")
  quotationsCreated             Quotation[]             @relation("QuotationCreatedBy")
  quotationsUpdated             Quotation[]             @relation("QuotationUpdatedBy")
  invoicesCreated               Invoice[]               @relation("InvoiceCreatedBy")
  invoicesUpdated               Invoice[]               @relation("InvoiceUpdatedBy")
  paymentsCreated               Payment[]               @relation("PaymentCreatedBy")
  paymentsVoided                Payment[]               @relation("PaymentVoidedBy")
  shareLinksCreated             ShareLink[]             @relation("ShareLinkCreatedBy")
  accountsCreated               Account[]               @relation("AccountCreatedBy")
  accountsUpdated               Account[]               @relation("AccountUpdatedBy")
  journalEntriesCreated         JournalEntry[]          @relation("JournalEntryCreatedBy")
  expensesIncurred              Expense[]               @relation("ExpenseEmployee")
  expensesDecided               Expense[]               @relation("ExpenseDecidedBy")
  expensesCreated               Expense[]               @relation("ExpenseCreatedBy")
  expensesUpdated               Expense[]               @relation("ExpenseUpdatedBy")
  authTokensCreated             AuthToken[]             @relation("AuthTokenCreatedBy")
  departmentsCreated            Department[]            @relation("DepartmentCreatedBy")
  departmentsUpdated            Department[]            @relation("DepartmentUpdatedBy")
  employeeProfiles              Employee[]              @relation("EmployeeUser")
  employeesCreated              Employee[]              @relation("EmployeeCreatedBy")
  employeesUpdated              Employee[]              @relation("EmployeeUpdatedBy")
  compensationsUpdated          EmployeeCompensation[]  @relation("EmployeeCompensationUpdatedBy")
  employeeDocumentsCreated      EmployeeDocument[]      @relation("EmployeeDocumentCreatedBy")
  attendanceCreated             AttendanceRecord[]      @relation("AttendanceCreatedBy")
  attendanceUpdated             AttendanceRecord[]      @relation("AttendanceUpdatedBy")
  leaveRequestsDecided          LeaveRequest[]          @relation("LeaveDecidedBy")
  leaveRequestsCreated          LeaveRequest[]          @relation("LeaveCreatedBy")
  leaveRequestsUpdated          LeaveRequest[]          @relation("LeaveUpdatedBy")
  salaryComponentsCreated       SalaryComponent[]       @relation("SalaryComponentCreatedBy")
  salaryComponentsUpdated       SalaryComponent[]       @relation("SalaryComponentUpdatedBy")
  salaryAdvancesCreated         SalaryAdvance[]         @relation("SalaryAdvanceCreatedBy")
  salaryAdvancesUpdated         SalaryAdvance[]         @relation("SalaryAdvanceUpdatedBy")
  payrollRunsCreated            PayrollRun[]            @relation("PayrollRunCreatedBy")
  payrollRunsUpdated            PayrollRun[]            @relation("PayrollRunUpdatedBy")
  payrollRunsApproved           PayrollRun[]            @relation("PayrollRunApprovedBy")
  payrollRunsPaid               PayrollRun[]            @relation("PayrollRunPaidBy")
  payrollItemsUpdated           PayrollItem[]           @relation("PayrollItemUpdatedBy")
  projectsCreated               Project[]               @relation("ProjectCreatedBy")
  projectsUpdated               Project[]               @relation("ProjectUpdatedBy")
  tasksCreated                  Task[]                  @relation("TaskCreatedBy")
  tasksUpdated                  Task[]                  @relation("TaskUpdatedBy")
  taskAttachmentsCreated        TaskAttachment[]        @relation("TaskAttachmentCreatedBy")
  productCategoriesCreated      ProductCategory[]       @relation("ProductCategoryCreatedBy")
  productCategoriesUpdated      ProductCategory[]       @relation("ProductCategoryUpdatedBy")
  warehousesCreated             Warehouse[]             @relation("WarehouseCreatedBy")
  warehousesUpdated             Warehouse[]             @relation("WarehouseUpdatedBy")
  productsCreated               Product[]               @relation("ProductCreatedBy")
  productsUpdated               Product[]               @relation("ProductUpdatedBy")
  stockMovementsCreated         StockMovement[]         @relation("StockMovementCreatedBy")
  suppliersCreated              Supplier[]              @relation("SupplierCreatedBy")
  suppliersUpdated              Supplier[]              @relation("SupplierUpdatedBy")
  purchaseRequestsRequested     PurchaseRequest[]       @relation("PurchaseRequestRequestedBy")
  purchaseRequestsDecided       PurchaseRequest[]       @relation("PurchaseRequestDecidedBy")
  purchaseRequestsCreated       PurchaseRequest[]       @relation("PurchaseRequestCreatedBy")
  purchaseRequestsUpdated       PurchaseRequest[]       @relation("PurchaseRequestUpdatedBy")
  purchaseOrdersCreated         PurchaseOrder[]         @relation("PurchaseOrderCreatedBy")
  purchaseOrdersUpdated         PurchaseOrder[]         @relation("PurchaseOrderUpdatedBy")
  goodsReceiptsCreated          GoodsReceipt[]          @relation("GoodsReceiptCreatedBy")
  supplierInvoicesCreated       SupplierInvoice[]       @relation("SupplierInvoiceCreatedBy")
  supplierInvoicesUpdated       SupplierInvoice[]       @relation("SupplierInvoiceUpdatedBy")
  supplierPaymentsCreated       SupplierPayment[]       @relation("SupplierPaymentCreatedBy")
  supplierPaymentsVoided        SupplierPayment[]       @relation("SupplierPaymentVoidedBy")

  @@map("users")
}

model Session {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// SHA-256 of the cookie token; the token itself is never stored.
  tokenHash         String   @unique @map("token_hash")
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt        DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  /// The company the user is working in (company switcher). Only honoured while the membership is ACTIVE.
  activeCompanyId   String?  @map("active_company_id") @db.Uuid
  /// Hard limit: the session can be extended by activity, but never beyond this.
  absoluteExpiresAt DateTime @default(dbgenerated("(now() + '30 days'::interval)")) @map("absolute_expires_at") @db.Timestamptz(3)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCompany Company? @relation(fields: [activeCompanyId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION

  @@map("auth_token_type")
}

/// Single-use links sent by email. Only the SHA-256 hash of the token is stored.
model AuthToken {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  type        AuthTokenType
  tokenHash   String        @unique @map("token_hash")
  /// For invitations: the company the user was invited to.
  companyId   String?       @map("company_id") @db.Uuid
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?       @map("created_by") @db.Uuid

  user      User     @relation("AuthTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("AuthTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// ─── Access control ──────────────────────────────────────────

/// Global catalogue of permissions, synced from src/lib/permissions by the seed. Not tenant-owned.
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// "module:action", e.g. "invoices:create".
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  /// Built-in roles (Owner, Admin, …) cannot be deleted.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("RoleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  rolePermissions RolePermission[]
  memberships     Membership[]

  @@unique([companyId, name])
  /// Target of composite foreign keys that keep children in the same company.
  @@unique([id, companyId])
  @@map("roles")
}

model RolePermission {
  companyId    String   @map("company_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String?  @map("created_by") @db.Uuid

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Composite FK: the role must belong to the same company.
  role       Role       @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("RolePermissionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([companyId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED

  @@map("membership_status")
}

/// A user's access to one company, with one role in that company.
model Membership {
  id          String           @id @default(uuid(7)) @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  roleId      String           @map("role_id") @db.Uuid
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?          @map("created_by") @db.Uuid
  updatedById String?          @map("updated_by") @db.Uuid

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User    @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Composite FK: the role must belong to the same company as the membership.
  role      Role    @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?   @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("MembershipUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("memberships")
}

// ─── Company settings ────────────────────────────────────────

/// Per-company preferences as validated key/value pairs. Keys, types and defaults are defined in
/// src/lib/settings/registry.ts — never read or write raw values without it.
model Setting {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  key         String
  value       Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("SettingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("SettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, key])
  @@map("settings")
}

// ─── Audit log (append-only) ─────────────────────────────────

/// Immutable history of important actions. Rows are never updated or deleted by the application,
/// so there are no updated_at / updated_by columns. company_id is null for account-level events
/// (e.g. sign-in) that do not belong to one company.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// Dotted verb, e.g. "customer.create", "auth.login".
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Restrict: a company with audit history cannot be hard-deleted (archive it instead).
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, entityType, entityId])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ─── Platform records already used by the app ────────────────

// ─── CRM (phase 06) ──────────────────────────────────────────

enum CustomerType {
  INDIVIDUAL
  BUSINESS

  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("customer_status")
}

/// Reference module for the repository → service → route pattern.
model Customer {
  id          String         @id @default(uuid(7)) @db.Uuid
  companyId   String         @map("company_id") @db.Uuid
  /// Customer ID shown to people ("CUS-0001"): per-company sequence from `number_sequences` (key "customer").
  number      Int
  name        String
  /// Organisation the customer works for (for individuals) or trades as.
  companyName String?        @map("company_name")
  email       String?
  phone       String?
  whatsapp    String?
  address     String?
  city        String?
  /// ISO 3166-1 alpha-2.
  country     String?        @db.Char(2)
  taxId       String?        @map("tax_id")
  type        CustomerType   @default(BUSINESS)
  status      CustomerStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?        @map("created_by") @db.Uuid
  updatedById String?        @map("updated_by") @db.Uuid
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)

  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy      User?                   @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?                   @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  documents      CustomerDocument[]
  communications CustomerCommunication[]
  convertedLeads Lead[]
  quotations     Quotation[]
  invoices       Invoice[]
  payments       Payment[]
  projects       Project[]

  @@unique([companyId, number])
  /// Target of composite foreign keys that keep children in the same company.
  @@unique([id, companyId])
  @@index([companyId, deletedAt])
  @@index([companyId, name])
  @@index([companyId, status])
  @@map("customers")
}

/// A file attached to a customer (contract, ID copy, …). The bytes live in file storage under `storage_key`.
model CustomerDocument {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  /// Original file name, cleaned for display and downloads.
  name        String
  storageKey  String   @unique @map("storage_key")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by") @db.Uuid

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer  Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?    @relation("CustomerDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, customerId, createdAt(sort: Desc)])
  @@map("customer_documents")
}

enum CommunicationChannel {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  SMS

  @@map("communication_channel")
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND

  @@map("communication_direction")
}

/// Communication log and notes on a customer ("called about renewal", "sent quote by WhatsApp").
model CustomerCommunication {
  id          String                  @id @default(uuid(7)) @db.Uuid
  companyId   String                  @map("company_id") @db.Uuid
  customerId  String                  @map("customer_id") @db.Uuid
  channel     CommunicationChannel
  /// Null for internal notes.
  direction   CommunicationDirection?
  subject     String?
  body        String
  occurredAt  DateTime                @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?                 @map("created_by") @db.Uuid

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer  Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?    @relation("CustomerCommunicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, customerId, occurredAt(sort: Desc)])
  @@map("customer_communications")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST

  @@map("lead_status")
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  EMAIL_CAMPAIGN
  PHONE
  WALK_IN
  EVENT
  ADVERTISING
  PARTNER
  OTHER

  @@map("lead_source")
}

/// A potential customer moving through the sales pipeline.
model Lead {
  id              String     @id @default(uuid(7)) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  /// Lead ID shown to people ("LEAD-0001"): per-company sequence (key "lead").
  number          Int
  name            String
  companyName     String?    @map("company_name")
  phone           String?
  email           String?
  source          LeadSource @default(OTHER)
  /// Company member responsible for the lead (becomes an employee link when HR ships). Checked in the service.
  assignedToId    String?    @map("assigned_to") @db.Uuid
  status          LeadStatus @default(NEW)
  /// In the company's base currency.
  expectedValue   Decimal?   @map("expected_value") @db.Decimal(18, 2)
  notes           String?
  followUpDate    DateTime?  @map("follow_up_date") @db.Date
  statusChangedAt DateTime   @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  /// Set when the lead was converted into a customer.
  customerId      String?    @map("customer_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById     String?    @map("created_by") @db.Uuid
  updatedById     String?    @map("updated_by") @db.Uuid
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignedTo User?       @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  customer   Customer?   @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy  User?       @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?       @relation("LeadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  quotations Quotation[]

  @@unique([companyId, number])
  /// Target of composite foreign keys (quotations created from a lead).
  @@unique([id, companyId])
  @@index([companyId, deletedAt, status])
  @@index([companyId, assignedToId])
  @@map("leads")
}

// ─── Sales (phase 07) ────────────────────────────────────────
// Money columns are NUMERIC(18,2) and are calculated with exact decimal arithmetic (src/lib/money.ts).

enum QuotationStatus {
  DRAFT
  SENT
  /// Accepted by the customer: the quotation is now a sales order (has an order number).
  CONFIRMED
  DECLINED
  /// Converted into an invoice.
  INVOICED
  CANCELLED

  @@map("quotation_status")
}

/// A quotation, which becomes a sales order when the customer confirms it (same record, `order_number` set).
model Quotation {
  id            String          @id @default(uuid(7)) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  /// Quotation number ("QUO-0001"), per company.
  number        Int
  /// Sales order number ("SO-0001"), assigned on confirmation.
  orderNumber   Int?            @map("order_number")
  customerId    String          @map("customer_id") @db.Uuid
  /// The lead this quotation came from, if any.
  leadId        String?         @map("lead_id") @db.Uuid
  quoteDate     DateTime        @map("quote_date") @db.Date
  expiryDate    DateTime        @map("expiry_date") @db.Date
  /// ISO 4217, copied from the company's base currency when created.
  currency      String          @db.Char(3)
  status        QuotationStatus @default(DRAFT)
  subtotal      Decimal         @db.Decimal(18, 2)
  discountTotal Decimal         @map("discount_total") @db.Decimal(18, 2)
  taxTotal      Decimal         @map("tax_total") @db.Decimal(18, 2)
  total         Decimal         @db.Decimal(18, 2)
  notes         String?
  terms         String?
  sentAt        DateTime?       @map("sent_at") @db.Timestamptz(3)
  confirmedAt   DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById   String?         @map("created_by") @db.Uuid
  updatedById   String?         @map("updated_by") @db.Uuid
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(3)

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer  Customer        @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  lead      Lead?           @relation(fields: [leadId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?           @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("QuotationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items     QuotationItem[]
  invoices  Invoice[]

  @@unique([companyId, number])
  @@unique([companyId, orderNumber])
  @@unique([id, companyId])
  @@index([companyId, deletedAt, status])
  @@index([companyId, customerId])
  @@map("quotations")
}

model QuotationItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  companyId       String  @map("company_id") @db.Uuid
  quotationId     String  @map("quotation_id") @db.Uuid
  /// Display order, 0-based.
  position        Int
  /// Product or service, as written on the document.
  description     String
  quantity        Decimal @db.Decimal(18, 3)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal @map("discount_percent") @db.Decimal(5, 2)
  taxRate         Decimal @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal    Decimal @map("line_subtotal") @db.Decimal(18, 2)
  discountAmount  Decimal @map("discount_amount") @db.Decimal(18, 2)
  taxAmount       Decimal @map("tax_amount") @db.Decimal(18, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(18, 2)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  quotation Quotation @relation(fields: [quotationId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, quotationId, position])
  @@map("quotation_items")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED

  @@map("invoice_status")
}

/// A customer invoice. "Overdue" is not stored: it is SENT / PARTIALLY_PAID with a due date in the past.
model Invoice {
  id            String        @id @default(uuid(7)) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  /// Sequence value; `code` is the invoice number as issued (prefix from settings + number), never changed.
  number        Int
  code          String
  customerId    String        @map("customer_id") @db.Uuid
  /// The quotation / sales order this invoice was created from, if any.
  quotationId   String?       @map("quotation_id") @db.Uuid
  invoiceDate   DateTime      @map("invoice_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  currency      String        @db.Char(3)
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(18, 2)
  discountTotal Decimal       @map("discount_total") @db.Decimal(18, 2)
  taxTotal      Decimal       @map("tax_total") @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  /// Sum of the non-voided payments; kept in the same transaction as every payment change.
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(18, 2)
  notes         String?
  terms         String?
  sentAt        DateTime?     @map("sent_at") @db.Timestamptz(3)
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById   String?       @map("created_by") @db.Uuid
  updatedById   String?       @map("updated_by") @db.Uuid
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(3)

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer  Customer      @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  quotation Quotation?    @relation(fields: [quotationId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?         @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  Payment[]

  @@unique([companyId, number])
  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, deletedAt, status, dueDate])
  @@index([companyId, customerId])
  @@index([companyId, invoiceDate])
  @@map("invoices")
}

model InvoiceItem {
  id              String  @id @default(uuid(7)) @db.Uuid
  companyId       String  @map("company_id") @db.Uuid
  invoiceId       String  @map("invoice_id") @db.Uuid
  position        Int
  description     String
  quantity        Decimal @db.Decimal(18, 3)
  unitPrice       Decimal @map("unit_price") @db.Decimal(18, 2)
  discountPercent Decimal @map("discount_percent") @db.Decimal(5, 2)
  taxRate         Decimal @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal    Decimal @map("line_subtotal") @db.Decimal(18, 2)
  discountAmount  Decimal @map("discount_amount") @db.Decimal(18, 2)
  taxAmount       Decimal @map("tax_amount") @db.Decimal(18, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(18, 2)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, invoiceId, position])
  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER

  @@map("payment_method")
}

/// Money received against an invoice. Never deleted: a mistaken payment is voided (with a reason).
model Payment {
  id          String        @id @default(uuid(7)) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  /// Payment ID ("PAY-0001"), per company.
  number      Int
  customerId  String        @map("customer_id") @db.Uuid
  invoiceId   String        @map("invoice_id") @db.Uuid
  amount      Decimal       @db.Decimal(18, 2)
  method      PaymentMethod
  reference   String?
  paymentDate DateTime      @map("payment_date") @db.Date
  notes       String?
  voidedAt    DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason  String?       @map("void_reason")
  voidedById  String?       @map("voided_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?       @map("created_by") @db.Uuid

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer  Customer @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  invoice   Invoice  @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?    @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy  User?    @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, invoiceId])
  @@index([companyId, customerId])
  @@index([companyId, paymentDate])
  @@map("payments")
}

enum ShareDocumentType {
  QUOTATION
  INVOICE

  @@map("share_document_type")
}

/// A revocable, expiring link that lets someone without an account download one document's PDF (e.g. sent by
/// WhatsApp). Only the SHA-256 hash of the token is stored.
model ShareLink {
  id             String            @id @default(uuid(7)) @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  documentType   ShareDocumentType @map("document_type")
  documentId     String            @map("document_id") @db.Uuid
  tokenHash      String            @unique @map("token_hash")
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?         @map("revoked_at") @db.Timestamptz(3)
  lastAccessedAt DateTime?         @map("last_accessed_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String?           @map("created_by") @db.Uuid

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ShareLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, documentType, documentId])
  @@map("share_links")
}

// ─── Expenses and accounting (phase 08) ──────────────────────
// Double-entry ledger: every journal entry's debits equal its credits (checked by the service AND by a deferred
// database trigger). Rules for automatic postings are documented in docs/accounting.md.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("account_type")
}

/// Chart of accounts, per company. System accounts (`system_key` set) are created automatically and used by
/// automatic postings; they can be renamed but not deleted.
model Account {
  id          String      @id @default(uuid(7)) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  code        String
  name        String
  type        AccountType
  /// e.g. "cash", "receivable", "expense_rent". Null for accounts people create.
  systemKey   String?     @map("system_key")
  description String?
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?     @map("created_by") @db.Uuid
  updatedById String?     @map("updated_by") @db.Uuid

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?         @relation("AccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?         @relation("AccountUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  lines     JournalLine[]

  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@unique([id, companyId])
  @@map("accounts")
}

enum TransactionType {
  INCOME
  EXPENSE
  PAYMENT
  PURCHASE
  SALES

  @@map("transaction_type")
}

/// A transaction in the ledger. Posted entries are never edited or deleted: a mistake is corrected by a reversing
/// entry (`reversal_of_id`).
model JournalEntry {
  id           String          @id @default(uuid(7)) @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  /// "JE-0001", per company.
  number       Int
  type         TransactionType
  entryDate    DateTime        @map("entry_date") @db.Date
  description  String
  reference    String?
  /// Makes automatic postings idempotent, e.g. "invoice:<id>:issue". Null for manual entries.
  postingKey   String?         @map("posting_key")
  /// What created it: INVOICE, PAYMENT, EXPENSE or MANUAL.
  sourceType   String          @map("source_type")
  sourceId     String?         @map("source_id") @db.Uuid
  /// Set on the reversing entry: the entry it cancels.
  reversalOfId String?         @map("reversal_of_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String?         @map("created_by") @db.Uuid

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy  User?          @relation("JournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reversalOf JournalEntry?  @relation("JournalReversal", fields: [reversalOfId, companyId], references: [id, companyId], onDelete: Restrict)
  reversals  JournalEntry[] @relation("JournalReversal")
  lines      JournalLine[]

  @@unique([companyId, number])
  @@unique([companyId, postingKey])
  @@unique([id, companyId])
  @@index([companyId, entryDate])
  @@index([companyId, sourceType, sourceId])
  @@map("journal_entries")
}

/// One side of a journal entry: exactly one of debit / credit is positive (CHECK constraint).
model JournalLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  entryId     String  @map("entry_id") @db.Uuid
  accountId   String  @map("account_id") @db.Uuid
  position    Int
  debit       Decimal @default(0) @db.Decimal(18, 2)
  credit      Decimal @default(0) @db.Decimal(18, 2)
  description String?

  company Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entry   JournalEntry @relation(fields: [entryId, companyId], references: [id, companyId], onDelete: Cascade)
  account Account      @relation(fields: [accountId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, accountId])
  @@index([companyId, entryId])
  @@map("journal_lines")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MARKETING
  TRANSPORTATION
  OFFICE_SUPPLIES
  SOFTWARE
  EQUIPMENT
  OTHER

  @@map("expense_category")
}

enum ExpensePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
  /// Not paid yet: owed to the vendor (accounts payable) until marked as paid.
  UNPAID

  @@map("expense_payment_method")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("expense_status")
}

/// A business expense, submitted by (or for) an employee and approved before it reaches the ledger.
model Expense {
  id                 String                @id @default(uuid(7)) @db.Uuid
  companyId          String                @map("company_id") @db.Uuid
  /// "EXP-0001", per company.
  number             Int
  category           ExpenseCategory
  amount             Decimal               @db.Decimal(18, 2)
  currency           String                @db.Char(3)
  expenseDate        DateTime              @map("expense_date") @db.Date
  vendor             String?
  paymentMethod      ExpensePaymentMethod  @map("payment_method")
  description        String
  /// The company member who incurred it (an employee record once HR ships).
  employeeId         String?               @map("employee_id") @db.Uuid
  status             ExpenseStatus         @default(PENDING)
  decisionNote       String?               @map("decision_note")
  decidedById        String?               @map("decided_by") @db.Uuid
  decidedAt          DateTime?             @map("decided_at") @db.Timestamptz(3)
  /// For UNPAID expenses: when and how the vendor was paid later.
  paidAt             DateTime?             @map("paid_at") @db.Date
  paidMethod         ExpensePaymentMethod? @map("paid_method")
  receiptKey         String?               @unique @map("receipt_key")
  receiptName        String?               @map("receipt_name")
  receiptContentType String?               @map("receipt_content_type")
  receiptSize        Int?                  @map("receipt_size")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById        String?               @map("created_by") @db.Uuid
  updatedById        String?               @map("updated_by") @db.Uuid
  deletedAt          DateTime?             @map("deleted_at") @db.Timestamptz(3)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  User?   @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  decidedBy User?   @relation("ExpenseDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  createdBy User?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, deletedAt, status])
  @@index([companyId, employeeId])
  @@index([companyId, expenseDate])
  @@map("expenses")
}

/// Per-company counters for human-readable numbers (customers, leads; invoices later). Incremented atomically.
// ─── HR (phase 09): employees, departments, attendance, leave. Rules: docs/hr.md ───

model Department {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?      @relation("DepartmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("DepartmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  employees Employee[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("departments")
}

enum EmploymentStatus {
  PROBATION
  ACTIVE
  ON_NOTICE
  SUSPENDED
  RESIGNED
  TERMINATED
}

/// An employee record. Salary and bank details live in `employee_compensations` (restricted, see docs/hr.md).
model Employee {
  id                       String           @id @default(uuid(7)) @db.Uuid
  companyId                String           @map("company_id") @db.Uuid
  /// "EMP-0001", per company.
  number                   Int
  /// The login used for self-service attendance and leave (optional; a member of this company).
  userId                   String?          @map("user_id") @db.Uuid
  name                     String
  email                    String?
  phone                    String?
  /// National ID (e.g. CNIC) or another identification number.
  identificationNumber     String?          @map("identification_number")
  departmentId             String?          @map("department_id") @db.Uuid
  position                 String?
  joiningDate              DateTime         @map("joining_date") @db.Date
  status                   EmploymentStatus @default(ACTIVE)
  /// Last day of work, required for resigned / terminated employees.
  exitDate                 DateTime?        @map("exit_date") @db.Date
  photoKey                 String?          @unique @map("photo_key")
  photoContentType         String?          @map("photo_content_type")
  photoUpdatedAt           DateTime?        @map("photo_updated_at") @db.Timestamptz(3)
  emergencyContactName     String?          @map("emergency_contact_name")
  emergencyContactRelation String?          @map("emergency_contact_relation")
  emergencyContactPhone    String?          @map("emergency_contact_phone")
  notes                    String?
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById              String?          @map("created_by") @db.Uuid
  updatedById              String?          @map("updated_by") @db.Uuid
  deletedAt                DateTime?        @map("deleted_at") @db.Timestamptz(3)

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user            User?                 @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  department      Department?           @relation(fields: [departmentId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy       User?                 @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                 @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  compensation    EmployeeCompensation?
  documents       EmployeeDocument[]
  attendance      AttendanceRecord[]
  leaves          LeaveRequest[]
  components      SalaryComponent[]
  advances        SalaryAdvance[]
  payrollItems    PayrollItem[]
  managedProjects Project[]             @relation("ProjectManager")
  assignedTasks   Task[]                @relation("TaskAssignee")

  @@unique([companyId, number])
  @@unique([companyId, userId])
  @@unique([id, companyId])
  @@index([companyId, deletedAt, status])
  @@index([companyId, departmentId])
  @@index([companyId, name])
  @@map("employees")
}

/// Salary and bank details, kept apart from the employee row so ordinary queries never load them. Needs
/// `salaries:view` / `salaries:edit`. Account number and IBAN are encrypted (AES-256-GCM, DATA_ENCRYPTION_KEY).
model EmployeeCompensation {
  id                  String   @id @default(uuid(7)) @db.Uuid
  companyId           String   @map("company_id") @db.Uuid
  employeeId          String   @map("employee_id") @db.Uuid
  /// Gross monthly salary.
  salary              Decimal? @db.Decimal(18, 2)
  currency            String   @db.Char(3)
  bankName            String?  @map("bank_name")
  accountTitle        String?  @map("account_title")
  /// Ciphertext ("v1:…"); decrypted only for people allowed to reveal it.
  accountNumberCipher String?  @map("account_number_cipher")
  accountNumberLast4  String?  @map("account_number_last4") @db.VarChar(4)
  ibanCipher          String?  @map("iban_cipher")
  ibanLast4           String?  @map("iban_last4") @db.VarChar(4)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById         String?  @map("updated_by") @db.Uuid

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  updatedBy User?    @relation("EmployeeCompensationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, companyId])
  @@index([companyId])
  @@map("employee_compensations")
}

model EmployeeDocument {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  /// Original file name, cleaned for display and downloads.
  name        String
  storageKey  String   @unique @map("storage_key")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by") @db.Uuid

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?    @relation("EmployeeDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId, createdAt(sort: Desc)])
  @@map("employee_documents")
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
}

enum AttendanceSource {
  /// The employee checked in / out in the app (server time).
  SELF
  /// Entered or corrected by HR.
  MANUAL
}

/// One employee's attendance on one calendar day (company time zone). Days without a record are derived as
/// absent or on leave when reports are computed.
model AttendanceRecord {
  id                String           @id @default(uuid(7)) @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  employeeId        String           @map("employee_id") @db.Uuid
  date              DateTime         @db.Date
  checkInAt         DateTime?        @map("check_in_at") @db.Timestamptz(3)
  checkOutAt        DateTime?        @map("check_out_at") @db.Timestamptz(3)
  status            AttendanceStatus
  lateMinutes       Int              @default(0) @map("late_minutes")
  earlyLeaveMinutes Int              @default(0) @map("early_leave_minutes")
  workedMinutes     Int?             @map("worked_minutes")
  source            AttendanceSource
  note              String?
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById       String?          @map("created_by") @db.Uuid
  updatedById       String?          @map("updated_by") @db.Uuid

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?    @relation("AttendanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, employeeId, date])
  @@index([companyId, date])
  @@map("attendance_records")
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  UNPAID
  MATERNITY
  PATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id                    String      @id @default(uuid(7)) @db.Uuid
  companyId             String      @map("company_id") @db.Uuid
  /// "LV-0001", per company.
  number                Int
  employeeId            String      @map("employee_id") @db.Uuid
  type                  LeaveType
  startDate             DateTime    @map("start_date") @db.Date
  endDate               DateTime    @map("end_date") @db.Date
  /// Working days covered (company work schedule at the time of the request).
  days                  Int
  reason                String
  attachmentKey         String?     @unique @map("attachment_key")
  attachmentName        String?     @map("attachment_name")
  attachmentContentType String?     @map("attachment_content_type")
  attachmentSize        Int?        @map("attachment_size")
  status                LeaveStatus @default(PENDING)
  decisionNote          String?     @map("decision_note")
  decidedById           String?     @map("decided_by") @db.Uuid
  decidedAt             DateTime?   @map("decided_at") @db.Timestamptz(3)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById           String?     @map("created_by") @db.Uuid
  updatedById           String?     @map("updated_by") @db.Uuid
  deletedAt             DateTime?   @map("deleted_at") @db.Timestamptz(3)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  decidedBy User?    @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  createdBy User?    @relation("LeaveCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("LeaveUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, employeeId, startDate])
  @@index([companyId, deletedAt, status])
  @@map("leave_requests")
}

// ─── Payroll (phase 10). Formula and rules: docs/payroll.md ───

enum SalaryComponentKind {
  ALLOWANCE
  DEDUCTION
  TAX
}

/// A recurring line of an employee's salary structure (the basic salary is employee_compensations.salary).
/// Restricted like the salary: `salaries:view` / `salaries:edit`.
model SalaryComponent {
  id          String              @id @default(uuid(7)) @db.Uuid
  companyId   String              @map("company_id") @db.Uuid
  employeeId  String              @map("employee_id") @db.Uuid
  kind        SalaryComponentKind
  name        String
  /// Monthly amount.
  amount      Decimal             @db.Decimal(18, 2)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?             @map("created_by") @db.Uuid
  updatedById String?             @map("updated_by") @db.Uuid

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?    @relation("SalaryComponentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?    @relation("SalaryComponentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([companyId, employeeId])
  @@map("salary_components")
}

enum SalaryAdvanceStatus {
  OUTSTANDING
  RECOVERED
  CANCELLED
}

/// Money paid to an employee ahead of payroll; recovered in full by the next paid payroll run.
model SalaryAdvance {
  id             String              @id @default(uuid(7)) @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  /// "ADV-0001", per company.
  number         Int
  employeeId     String              @map("employee_id") @db.Uuid
  amount         Decimal             @db.Decimal(18, 2)
  advanceDate    DateTime            @map("advance_date") @db.Date
  paymentMethod  PaymentMethod       @map("payment_method")
  reason         String
  status         SalaryAdvanceStatus @default(OUTSTANDING)
  recoveredRunId String?             @map("recovered_run_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?             @map("created_by") @db.Uuid
  updatedById    String?             @map("updated_by") @db.Uuid

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee     Employee    @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  recoveredRun PayrollRun? @relation(fields: [recoveredRunId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy    User?       @relation("SalaryAdvanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?       @relation("SalaryAdvanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, employeeId, status])
  @@map("salary_advances")
}

enum PayrollStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  CANCELLED
}

/// One payroll run per company and month: Draft → Submitted → Approved → Paid (or Cancelled).
model PayrollRun {
  id           String         @id @default(uuid(7)) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  /// "PRL-0001", per company.
  number       Int
  periodYear   Int            @map("period_year")
  periodMonth  Int            @map("period_month")
  periodStart  DateTime       @map("period_start") @db.Date
  periodEnd    DateTime       @map("period_end") @db.Date
  /// "YYYY-MM" while the run is not cancelled, null once cancelled: unique per company, so a month can't be
  /// processed twice (cancelled runs don't block a new one).
  activePeriod String?        @map("active_period") @db.VarChar(7)
  payDate      DateTime       @map("pay_date") @db.Date
  currency     String         @db.Char(3)
  status       PayrollStatus  @default(DRAFT)
  notes        String?
  reviewNote   String?        @map("review_note")
  approvedById String?        @map("approved_by") @db.Uuid
  approvedAt   DateTime?      @map("approved_at") @db.Timestamptz(3)
  paidAt       DateTime?      @map("paid_at") @db.Date
  paidMethod   PaymentMethod? @map("paid_method")
  paidById     String?        @map("paid_by") @db.Uuid
  cancelReason String?        @map("cancel_reason")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?        @map("created_by") @db.Uuid
  updatedById  String?        @map("updated_by") @db.Uuid

  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy         User?           @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?           @relation("PayrollRunUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy        User?           @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy            User?           @relation("PayrollRunPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  items             PayrollItem[]
  recoveredAdvances SalaryAdvance[]

  @@unique([companyId, number])
  @@unique([companyId, activePeriod])
  @@unique([id, companyId])
  @@index([companyId, periodYear, periodMonth])
  @@map("payroll_runs")
}

/// One employee's pay in a run. The database checks net = basic + allowances + bonus + overtime − deductions −
/// tax − advances. Name, number, department and position are snapshots so payslips never change afterwards.
model PayrollItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  employeeNumber Int      @map("employee_number")
  employeeName   String   @map("employee_name")
  departmentName String?  @map("department_name")
  position       String?
  basic          Decimal  @db.Decimal(18, 2)
  allowances     Decimal  @db.Decimal(18, 2)
  bonus          Decimal  @db.Decimal(18, 2)
  overtime       Decimal  @db.Decimal(18, 2)
  deductions     Decimal  @db.Decimal(18, 2)
  tax            Decimal  @db.Decimal(18, 2)
  advances       Decimal  @db.Decimal(18, 2)
  net            Decimal  @db.Decimal(18, 2)
  /// Snapshot of the structure lines and recovered advances: [{ kind, name, amount, advanceId? }].
  lines          Json
  /// Joined or left during the period — the basic salary is not prorated automatically (review it).
  partialPeriod  Boolean  @default(false) @map("partial_period")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById    String?  @map("updated_by") @db.Uuid

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  run       PayrollRun @relation(fields: [runId, companyId], references: [id, companyId], onDelete: Cascade)
  employee  Employee   @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  updatedBy User?      @relation("PayrollItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([runId, employeeId])
  @@index([companyId, employeeId])
  @@map("payroll_items")
}

// ─── Projects and tasks (phase 11). Rules: docs/projects.md ───

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(uuid(7)) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  /// "PRJ-0001", per company.
  number      Int
  name        String
  customerId  String?       @map("customer_id") @db.Uuid
  /// The employee managing the project.
  managerId   String?       @map("manager_id") @db.Uuid
  startDate   DateTime?     @map("start_date") @db.Date
  endDate     DateTime?     @map("end_date") @db.Date
  budget      Decimal?      @db.Decimal(18, 2)
  currency    String        @db.Char(3)
  status      ProjectStatus @default(PLANNING)
  description String?
  completedAt DateTime?     @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?       @map("created_by") @db.Uuid
  updatedById String?       @map("updated_by") @db.Uuid
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer  Customer? @relation(fields: [customerId, companyId], references: [id, companyId], onDelete: Restrict)
  manager   Employee? @relation("ProjectManager", fields: [managerId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?     @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?     @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@index([companyId, deletedAt, status])
  @@index([companyId, customerId])
  @@index([companyId, managerId])
  @@map("projects")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  /// "TSK-0001", per company.
  number      Int
  projectId   String       @map("project_id") @db.Uuid
  name        String
  /// The employee the task is assigned to.
  assigneeId  String?      @map("assignee_id") @db.Uuid
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  startDate   DateTime?    @map("start_date") @db.Date
  dueDate     DateTime?    @map("due_date") @db.Date
  description String?
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?      @map("created_by") @db.Uuid
  updatedById String?      @map("updated_by") @db.Uuid
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(3)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project     Project          @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Restrict)
  assignee    Employee?        @relation("TaskAssignee", fields: [assigneeId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy   User?            @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?            @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  attachments TaskAttachment[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@index([companyId, projectId, deletedAt, status])
  @@index([companyId, assigneeId, deletedAt, status])
  @@index([companyId, dueDate])
  @@map("tasks")
}

model TaskAttachment {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  /// Original file name, cleaned for display and downloads.
  name        String
  storageKey  String   @unique @map("storage_key")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?  @map("created_by") @db.Uuid

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  task      Task    @relation(fields: [taskId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?   @relation("TaskAttachmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, taskId, createdAt(sort: Desc)])
  @@map("task_attachments")
}

// ─── Inventory and purchasing (phase 12). Rules: docs/inventory.md ───

model ProductCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("ProductCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?     @relation("ProductCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  products  Product[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("product_categories")
}

model Warehouse {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  address     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by") @db.Uuid
  updatedById String?  @map("updated_by") @db.Uuid

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy      User?           @relation("WarehouseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?           @relation("WarehouseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  products       Product[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("warehouses")
}

/// A stocked item. There is deliberately no "current stock" column: stock is the sum of `stock_movements`.
model Product {
  id            String    @id @default(uuid(7)) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  /// "PRD-0001", per company.
  number        Int
  /// Stock keeping unit, unique per company (kept by deleted products too).
  sku           String
  name          String
  categoryId    String?   @map("category_id") @db.Uuid
  brand         String?
  /// e.g. "pcs", "kg", "box".
  unit          String
  purchasePrice Decimal   @map("purchase_price") @db.Decimal(18, 2)
  sellingPrice  Decimal   @map("selling_price") @db.Decimal(18, 2)
  /// Low-stock threshold: stock at or below this is "low".
  minimumStock  Decimal   @default(0) @map("minimum_stock") @db.Decimal(18, 3)
  /// Preferred supplier.
  supplierId    String?   @map("supplier_id") @db.Uuid
  /// Default warehouse (stock itself can be in any warehouse).
  warehouseId   String?   @map("warehouse_id") @db.Uuid
  description   String?
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById   String?   @map("created_by") @db.Uuid
  updatedById   String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category             ProductCategory?      @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  supplier             Supplier?             @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  warehouse            Warehouse?            @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy            User?                 @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            User?                 @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  stockMovements       StockMovement[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  goodsReceiptItems    GoodsReceiptItem[]

  @@unique([companyId, number])
  @@unique([companyId, sku])
  @@unique([id, companyId])
  @@index([companyId, deletedAt, name])
  @@index([companyId, categoryId])
  @@index([companyId, supplierId])
  @@map("products")
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  GOODS_RECEIPT
}

/// The inventory ledger: every change to stock is one row. Append-only (a trigger refuses UPDATE and DELETE).
model StockMovement {
  id             String            @id @default(uuid(7)) @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  /// "STK-0001", per company.
  number         Int
  productId      String            @map("product_id") @db.Uuid
  warehouseId    String            @map("warehouse_id") @db.Uuid
  type           StockMovementType
  /// Signed: positive adds stock, negative removes it. Never zero.
  quantity       Decimal           @db.Decimal(18, 3)
  /// Cost per unit for incoming stock (purchase price), when known.
  unitCost       Decimal?          @map("unit_cost") @db.Decimal(18, 2)
  movementDate   DateTime          @map("movement_date") @db.Date
  reference      String?
  note           String?
  /// Both rows of a transfer share this id.
  transferId     String?           @map("transfer_id") @db.Uuid
  goodsReceiptId String?           @map("goods_receipt_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById    String?           @map("created_by") @db.Uuid

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product      Product       @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  warehouse    Warehouse     @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict)
  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy    User?         @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, productId, warehouseId])
  @@index([companyId, movementDate])
  @@index([companyId, transferId])
  @@map("stock_movements")
}

model Supplier {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  /// "SUP-0001", per company.
  number      Int
  name        String
  companyName String?   @map("company_name")
  phone       String?
  email       String?
  address     String?
  /// Tax registration number (NTN/VAT/GST …).
  taxId       String?   @map("tax_id")
  notes       String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy        User?             @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?             @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  products         Product[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  invoices         SupplierInvoice[]
  payments         SupplierPayment[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@index([companyId, deletedAt, name])
  @@map("suppliers")
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

model PurchaseRequest {
  id            String                @id @default(uuid(7)) @db.Uuid
  companyId     String                @map("company_id") @db.Uuid
  /// "PR-0001", per company.
  number        Int
  requestedById String?               @map("requested_by") @db.Uuid
  /// Suggested supplier (the purchase order decides).
  supplierId    String?               @map("supplier_id") @db.Uuid
  neededBy      DateTime?             @map("needed_by") @db.Date
  reason        String
  status        PurchaseRequestStatus @default(PENDING)
  decisionNote  String?               @map("decision_note")
  decidedById   String?               @map("decided_by") @db.Uuid
  decidedAt     DateTime?             @map("decided_at") @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById   String?               @map("created_by") @db.Uuid
  updatedById   String?               @map("updated_by") @db.Uuid

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier      Supplier?             @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  requestedBy   User?                 @relation("PurchaseRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy     User?                 @relation("PurchaseRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  createdBy     User?                 @relation("PurchaseRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                 @relation("PurchaseRequestUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items         PurchaseRequestItem[]
  purchaseOrder PurchaseOrder?

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                 String   @id @default(uuid(7)) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  requestId          String   @map("request_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  quantity           Decimal  @db.Decimal(18, 3)
  /// Estimate only; the purchase order carries the agreed price.
  estimatedUnitPrice Decimal? @map("estimated_unit_price") @db.Decimal(18, 2)
  position           Int

  company Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  request PurchaseRequest @relation(fields: [requestId, companyId], references: [id, companyId], onDelete: Cascade)
  product Product         @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, requestId])
  @@map("purchase_request_items")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(uuid(7)) @db.Uuid
  companyId    String              @map("company_id") @db.Uuid
  /// "PO-0001", per company.
  number       Int
  supplierId   String              @map("supplier_id") @db.Uuid
  /// The approved purchase request this order fulfils (one order per request).
  requestId    String?             @map("request_id") @db.Uuid
  /// Where the goods are received.
  warehouseId  String              @map("warehouse_id") @db.Uuid
  orderDate    DateTime            @map("order_date") @db.Date
  expectedDate DateTime?           @map("expected_date") @db.Date
  status       PurchaseOrderStatus @default(DRAFT)
  total        Decimal             @db.Decimal(18, 2)
  currency     String              @db.Char(3)
  notes        String?
  orderedAt    DateTime?           @map("ordered_at") @db.Timestamptz(3)
  cancelledAt  DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?             @map("cancel_reason")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?             @map("created_by") @db.Uuid
  updatedById  String?             @map("updated_by") @db.Uuid

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier  Supplier            @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  request   PurchaseRequest?    @relation(fields: [requestId, companyId], references: [id, companyId], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?               @relation("PurchaseOrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]
  receipts  GoodsReceipt[]
  invoices  SupplierInvoice[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@unique([requestId, companyId])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id        String  @id @default(uuid(7)) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @db.Decimal(18, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(18, 2)
  /// quantity × unit price, rounded to cents.
  lineTotal Decimal @map("line_total") @db.Decimal(18, 2)
  position  Int

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  order        PurchaseOrder      @relation(fields: [orderId, companyId], references: [id, companyId], onDelete: Cascade)
  product      Product            @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  receiptItems GoodsReceiptItem[]

  @@unique([id, companyId])
  @@index([companyId, orderId])
  @@map("purchase_order_items")
}

/// Goods received against a purchase order. Each line adds stock through a GOODS_RECEIPT stock movement.
model GoodsReceipt {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  /// "GRN-0001", per company.
  number       Int
  orderId      String   @map("order_id") @db.Uuid
  warehouseId  String   @map("warehouse_id") @db.Uuid
  receivedDate DateTime @map("received_date") @db.Date
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById  String?  @map("created_by") @db.Uuid

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  order          PurchaseOrder      @relation(fields: [orderId, companyId], references: [id, companyId], onDelete: Restrict)
  warehouse      Warehouse          @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy      User?              @relation("GoodsReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items          GoodsReceiptItem[]
  stockMovements StockMovement[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@index([companyId, orderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  receiptId   String  @map("receipt_id") @db.Uuid
  orderItemId String  @map("order_item_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  quantity    Decimal @db.Decimal(18, 3)

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  receipt   GoodsReceipt      @relation(fields: [receiptId, companyId], references: [id, companyId], onDelete: Restrict)
  orderItem PurchaseOrderItem @relation(fields: [orderItemId, companyId], references: [id, companyId], onDelete: Restrict)
  product   Product           @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, receiptId])
  @@index([companyId, orderItemId])
  @@map("goods_receipt_items")
}

enum SupplierInvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// A bill from a supplier ("BILL-0001"). Recording it posts to Accounts Payable (rule B1).
model SupplierInvoice {
  id                String                @id @default(uuid(7)) @db.Uuid
  companyId         String                @map("company_id") @db.Uuid
  number            Int
  supplierId        String                @map("supplier_id") @db.Uuid
  orderId           String?               @map("order_id") @db.Uuid
  /// The supplier's own invoice number.
  supplierReference String?               @map("supplier_reference")
  invoiceDate       DateTime              @map("invoice_date") @db.Date
  dueDate           DateTime?             @map("due_date") @db.Date
  subtotal          Decimal               @db.Decimal(18, 2)
  taxAmount         Decimal               @map("tax_amount") @db.Decimal(18, 2)
  total             Decimal               @db.Decimal(18, 2)
  amountPaid        Decimal               @default(0) @map("amount_paid") @db.Decimal(18, 2)
  currency          String                @db.Char(3)
  status            SupplierInvoiceStatus @default(UNPAID)
  notes             String?
  cancelledAt       DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelReason      String?               @map("cancel_reason")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById       String?               @map("created_by") @db.Uuid
  updatedById       String?               @map("updated_by") @db.Uuid

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier  Supplier          @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  order     PurchaseOrder?    @relation(fields: [orderId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?             @relation("SupplierInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?             @relation("SupplierInvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  payments  SupplierPayment[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@index([companyId, orderId])
  @@map("supplier_invoices")
}

/// Money paid to a supplier against a bill ("SPAY-0001"). Never deleted: a mistake is voided (rule B4).
model SupplierPayment {
  id          String        @id @default(uuid(7)) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  number      Int
  supplierId  String        @map("supplier_id") @db.Uuid
  invoiceId   String        @map("invoice_id") @db.Uuid
  amount      Decimal       @db.Decimal(18, 2)
  method      PaymentMethod
  reference   String?
  paymentDate DateTime      @map("payment_date") @db.Date
  notes       String?
  voidedAt    DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason  String?       @map("void_reason")
  voidedById  String?       @map("voided_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String?       @map("created_by") @db.Uuid

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier  Supplier        @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  invoice   SupplierInvoice @relation(fields: [invoiceId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy User?           @relation("SupplierPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy  User?           @relation("SupplierPaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  @@unique([companyId, number])
  @@index([companyId, invoiceId])
  @@index([companyId, supplierId])
  @@index([companyId, paymentDate])
  @@map("supplier_payments")
}

model NumberSequence {
  companyId String   @map("company_id") @db.Uuid
  /// e.g. "customer", "lead".
  key       String
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, key])
  @@map("number_sequences")
}

/// In-app notifications; the header bell shows the unread count (phase 13 adds the full feature).
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, readAt])
  @@map("notifications")
}
